[init]
	defaultBranch = main

[user]
	name = Bendik Johansen
	email = bendikj@gmail.com

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	tabs = 4
	side-by-side = false

[merge]
	conflictstyle = diff3

[gpg]
  format = ssh

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
